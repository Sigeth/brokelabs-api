{
  "openapi": "3.1.0",
  "info": {
    "title": "opslab api",
    "description": "Platform API of opslab (working name).",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs in with a local account.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs out.",
        "operationId": "logout",
        "responses": {
          "204": {}
        }
      }
    },
    "/api/v1/challenges": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Installed challenges, with the user's progress.",
        "operationId": "list_challenges",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChallengeSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/challenges/{name}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "A challenge, with its instructions and tasks.",
        "operationId": "get_challenge",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Challenge name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChallengeDetail"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Server-sent events of the signed-in user (instances and checks). See the\n`Event` schema.",
        "operationId": "events",
        "responses": {
          "200": {
            "description": "text/event-stream of Event JSON objects",
            "content": {
              "text/event-stream": {}
            }
          }
        }
      }
    },
    "/api/v1/instances": {
      "get": {
        "tags": [
          "instances"
        ],
        "summary": "The user's active instances.",
        "operationId": "list_instances",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InstanceView"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "instances"
        ],
        "summary": "Starts a challenge. A user has one active instance at a time.",
        "operationId": "start_instance",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartInstance"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceView"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/instances/{id}": {
      "get": {
        "tags": [
          "instances"
        ],
        "summary": "An instance of the user.",
        "operationId": "get_instance",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Instance ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceView"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "instances"
        ],
        "summary": "Stops an instance. Everything in it is lost; scores are kept.",
        "operationId": "stop_instance",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Instance ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/instances/{id}/checks": {
      "get": {
        "tags": [
          "instances"
        ],
        "summary": "The latest check of an instance.",
        "operationId": "latest_check",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Instance ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/CheckRunView"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "instances"
        ],
        "summary": "Checks every task of an instance. Results arrive as events.",
        "operationId": "start_check",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Instance ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckRunView"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/instances/{id}/terminals": {
      "post": {
        "tags": [
          "instances"
        ],
        "summary": "Opens a terminal: returns the gateway URL with a short-lived token.",
        "operationId": "open_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Instance ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenTerminal"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalAccess"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The signed-in user and their score.",
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Returns the version of the api.",
        "operationId": "version",
        "responses": {
          "200": {
            "description": "Version of the api",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChallengeDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ChallengeSummary"
          },
          {
            "type": "object",
            "required": [
              "taskList",
              "terminals"
            ],
            "properties": {
              "instructions": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Student instructions, in markdown."
              },
              "taskList": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TaskView"
                }
              },
              "terminals": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          }
        ],
        "description": "A challenge with its instructions and tasks."
      },
      "ChallengeSummary": {
        "type": "object",
        "description": "A challenge in the catalog.",
        "required": [
          "name",
          "version",
          "title",
          "summary",
          "category",
          "difficulty",
          "tags",
          "points",
          "solvedPoints",
          "tasks",
          "solvedTasks",
          "runnable"
        ],
        "properties": {
          "category": {
            "type": "string",
            "description": "linux-hardening, containers or kubernetes."
          },
          "difficulty": {
            "type": "string",
            "description": "easy, medium, hard or insane."
          },
          "estimatedMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Typical time to solve, in minutes."
          },
          "name": {
            "type": "string"
          },
          "points": {
            "type": "integer",
            "format": "int64",
            "description": "Points of all tasks."
          },
          "runnable": {
            "type": "boolean",
            "description": "False when this cluster cannot run the challenge."
          },
          "solvedPoints": {
            "type": "integer",
            "format": "int64",
            "description": "Points the user has already scored."
          },
          "solvedTasks": {
            "type": "integer",
            "minimum": 0
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tasks": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "unrunnableReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "string"
          }
        }
      },
      "CheckPhase": {
        "type": "string",
        "description": "Lifecycle phase of a check run.",
        "enum": [
          "Pending",
          "Running",
          "Completed",
          "Error"
        ]
      },
      "CheckRunView": {
        "type": "object",
        "description": "A validation of an instance.",
        "required": [
          "id",
          "instance",
          "phase",
          "results",
          "newlySolved"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Explains an Error phase."
          },
          "newlySolved": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tasks this run solved for the first time."
          },
          "phase": {
            "$ref": "#/components/schemas/CheckPhase"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskResultView"
            }
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Body of every error response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "What went wrong, for humans."
          }
        }
      },
      "Event": {
        "oneOf": [
          {
            "type": "object",
            "description": "An instance of the user changed.",
            "required": [
              "instance",
              "type"
            ],
            "properties": {
              "instance": {
                "$ref": "#/components/schemas/InstanceView"
              },
              "type": {
                "type": "string",
                "enum": [
                  "instance"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "An instance of the user is gone.",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "instanceDeleted"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "A check run of the user changed.",
            "required": [
              "check",
              "type"
            ],
            "properties": {
              "check": {
                "$ref": "#/components/schemas/CheckRunView"
              },
              "type": {
                "type": "string",
                "enum": [
                  "check"
                ]
              }
            }
          }
        ],
        "description": "Pushed on GET /api/v1/events (server-sent events, one JSON object per message)."
      },
      "InstancePhase": {
        "type": "string",
        "description": "Lifecycle phase of an instance.",
        "enum": [
          "Queued",
          "Provisioning",
          "Ready",
          "Expired",
          "Failed",
          "Stopping"
        ]
      },
      "InstanceView": {
        "type": "object",
        "description": "A running attempt of the user.",
        "required": [
          "id",
          "challenge",
          "phase",
          "terminals"
        ],
        "properties": {
          "challenge": {
            "type": "string"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "description": "Instance name, used in /instances/{id} paths."
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the instance is in its phase (progress, failure reason...)."
          },
          "phase": {
            "$ref": "#/components/schemas/InstancePhase"
          },
          "terminals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TerminalView"
            }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "Me": {
        "type": "object",
        "description": "The signed-in user.",
        "required": [
          "id",
          "username",
          "displayName",
          "role",
          "score"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "description": "admin, teacher or student."
          },
          "score": {
            "type": "integer",
            "format": "int64",
            "description": "Points of every solved task."
          },
          "username": {
            "type": "string"
          }
        }
      },
      "OpenTerminal": {
        "type": "object",
        "required": [
          "machine"
        ],
        "properties": {
          "machine": {
            "type": "string",
            "description": "Machine of one of the challenge's terminals."
          }
        }
      },
      "StartInstance": {
        "type": "object",
        "required": [
          "challenge"
        ],
        "properties": {
          "challenge": {
            "type": "string",
            "description": "Name of the challenge."
          }
        }
      },
      "TaskResultView": {
        "type": "object",
        "description": "Result of checking one task.",
        "required": [
          "task",
          "passed"
        ],
        "properties": {
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "task": {
            "type": "string"
          }
        }
      },
      "TaskView": {
        "type": "object",
        "description": "A gradable objective.",
        "required": [
          "id",
          "title",
          "points",
          "solved"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "points": {
            "type": "integer",
            "format": "int32"
          },
          "solved": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "TerminalAccess": {
        "type": "object",
        "description": "Where the browser opens a terminal.",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "WebSocket URL of the gateway, with a short-lived token."
          }
        }
      },
      "TerminalView": {
        "type": "object",
        "description": "A terminal offered on a machine.",
        "required": [
          "machine",
          "label"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "machine": {
            "type": "string"
          }
        }
      },
      "VersionInfo": {
        "type": "object",
        "description": "Version of the running api.",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Project name."
          },
          "version": {
            "type": "string",
            "description": "Semantic version of the api."
          }
        }
      }
    }
  }
}
