{
  "openapi": "3.1.0",
  "info": {
    "title": "opslab api",
    "description": "Platform API of opslab (working name).",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/admin/catalogs": {
      "get": {
        "tags": [
          "marketplace"
        ],
        "summary": "Catalog sources and their last sync.",
        "operationId": "list_catalogs",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogView"
                  }
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "marketplace"
        ],
        "summary": "Adds a catalog source. The operator syncs and verifies it.",
        "operationId": "add_catalog",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewCatalog"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogView"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/catalogs/{name}": {
      "delete": {
        "tags": [
          "marketplace"
        ],
        "summary": "Removes a catalog source, the challenges installed from it and their\nrunning instances (D43).",
        "operationId": "remove_catalog",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Catalog source name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {},
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/challenges": {
      "get": {
        "tags": [
          "marketplace"
        ],
        "summary": "Installed challenges, whatever their source.",
        "operationId": "list_installed",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InstalledView"
                  }
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/challenges/{name}": {
      "put": {
        "tags": [
          "marketplace"
        ],
        "summary": "Installs a challenge from a catalog source, or moves it to another\nversion. The operator verifies the package against the trust policy of\nthe source and its permissions against the platform policy.",
        "operationId": "install",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Package name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstallRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstalledView"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "marketplace"
        ],
        "summary": "Removes a challenge and stops its running instances (D43). Scores stay.",
        "operationId": "remove_challenge",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Challenge name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {},
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/marketplace": {
      "get": {
        "tags": [
          "marketplace"
        ],
        "summary": "Packages listed by every catalog source, with what is installed.",
        "operationId": "marketplace",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MarketplaceEntry"
                  }
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs in with a local account.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs out.",
        "operationId": "logout",
        "responses": {
          "204": {}
        }
      }
    },
    "/api/v1/challenges": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Installed challenges, with the user's progress.",
        "operationId": "list_challenges",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChallengeSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/challenges/{name}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "A challenge, with its instructions and tasks.",
        "operationId": "get_challenge",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Challenge name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChallengeDetail"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Server-sent events of the signed-in user (instances and checks). See the\n`Event` schema.",
        "operationId": "events",
        "responses": {
          "200": {
            "description": "text/event-stream of Event JSON objects",
            "content": {
              "text/event-stream": {}
            }
          }
        }
      }
    },
    "/api/v1/instances": {
      "get": {
        "tags": [
          "instances"
        ],
        "summary": "The user's active instances.",
        "operationId": "list_instances",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InstanceView"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "instances"
        ],
        "summary": "Starts a challenge. A user has one active instance at a time.",
        "operationId": "start_instance",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartInstance"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceView"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/instances/{id}": {
      "get": {
        "tags": [
          "instances"
        ],
        "summary": "An instance of the user.",
        "operationId": "get_instance",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Instance ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstanceView"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "instances"
        ],
        "summary": "Stops an instance. Everything in it is lost; scores are kept.",
        "operationId": "stop_instance",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Instance ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {},
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/instances/{id}/checks": {
      "get": {
        "tags": [
          "instances"
        ],
        "summary": "The latest check of an instance.",
        "operationId": "latest_check",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Instance ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/CheckRunView"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "instances"
        ],
        "summary": "Checks every task of an instance. Results arrive as events.",
        "operationId": "start_check",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Instance ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckRunView"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/instances/{id}/terminals": {
      "post": {
        "tags": [
          "instances"
        ],
        "summary": "Opens a terminal: returns the gateway URL with a short-lived token.",
        "operationId": "open_terminal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Instance ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenTerminal"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TerminalAccess"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "The signed-in user and their score.",
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Returns the version of the api.",
        "operationId": "version",
        "responses": {
          "200": {
            "description": "Version of the api",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogView": {
        "type": "object",
        "description": "A catalog source and its last sync.",
        "required": [
          "name",
          "ref",
          "trust",
          "ready",
          "packages",
          "managedByChart"
        ],
        "properties": {
          "lastSync": {
            "type": [
              "string",
              "null"
            ],
            "description": "RFC 3339 time of the last successful sync."
          },
          "managedByChart": {
            "type": "boolean",
            "description": "Installed by the Helm chart (the official catalog): removing it here\nlasts until the next upgrade, unless the chart values disable it."
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the source is not ready, or what the last sync found."
          },
          "name": {
            "type": "string"
          },
          "packages": {
            "type": "integer",
            "description": "Packages listed by the last verified index.",
            "minimum": 0
          },
          "ready": {
            "type": "boolean",
            "description": "The last sync verified the index."
          },
          "ref": {
            "type": "string",
            "description": "OCI reference of the catalog index."
          },
          "signer": {
            "type": [
              "string",
              "null"
            ],
            "description": "Who signed the index."
          },
          "trust": {
            "$ref": "#/components/schemas/TrustView"
          }
        }
      },
      "ChallengeDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ChallengeSummary"
          },
          {
            "type": "object",
            "required": [
              "taskList",
              "terminals"
            ],
            "properties": {
              "instructions": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Student instructions, in markdown."
              },
              "taskList": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TaskView"
                }
              },
              "terminals": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TerminalView"
                }
              }
            }
          }
        ],
        "description": "A challenge with its instructions and tasks."
      },
      "ChallengeSummary": {
        "type": "object",
        "description": "A challenge in the catalog.",
        "required": [
          "name",
          "version",
          "title",
          "summary",
          "category",
          "difficulty",
          "tags",
          "points",
          "solvedPoints",
          "tasks",
          "solvedTasks",
          "runnable"
        ],
        "properties": {
          "category": {
            "type": "string",
            "description": "linux-hardening, containers or kubernetes."
          },
          "difficulty": {
            "type": "string",
            "description": "easy, medium, hard or insane."
          },
          "estimatedMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Typical time to solve, in minutes."
          },
          "name": {
            "type": "string"
          },
          "points": {
            "type": "integer",
            "format": "int64",
            "description": "Points of all tasks."
          },
          "runnable": {
            "type": "boolean",
            "description": "False when this cluster cannot run the challenge."
          },
          "solvedPoints": {
            "type": "integer",
            "format": "int64",
            "description": "Points the user has already scored."
          },
          "solvedTasks": {
            "type": "integer",
            "minimum": 0
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tasks": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "unrunnableReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "string"
          }
        }
      },
      "CheckPhase": {
        "type": "string",
        "description": "Lifecycle phase of a check run.",
        "enum": [
          "Pending",
          "Running",
          "Completed",
          "Error"
        ]
      },
      "CheckRunView": {
        "type": "object",
        "description": "A validation of an instance.",
        "required": [
          "id",
          "instance",
          "phase",
          "results",
          "newlySolved"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Explains an Error phase."
          },
          "newlySolved": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tasks this run solved for the first time."
          },
          "phase": {
            "$ref": "#/components/schemas/CheckPhase"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskResultView"
            }
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Body of every error response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "What went wrong, for humans."
          }
        }
      },
      "Event": {
        "oneOf": [
          {
            "type": "object",
            "description": "An instance of the user changed.",
            "required": [
              "instance",
              "type"
            ],
            "properties": {
              "instance": {
                "$ref": "#/components/schemas/InstanceView"
              },
              "type": {
                "type": "string",
                "enum": [
                  "instance"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "An instance of the user is gone.",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "instanceDeleted"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "A check run of the user changed.",
            "required": [
              "check",
              "type"
            ],
            "properties": {
              "check": {
                "$ref": "#/components/schemas/CheckRunView"
              },
              "type": {
                "type": "string",
                "enum": [
                  "check"
                ]
              }
            }
          }
        ],
        "description": "Pushed on GET /api/v1/events (server-sent events, one JSON object per message)."
      },
      "InstallRequest": {
        "type": "object",
        "description": "Installs or updates a challenge from a catalog source.",
        "required": [
          "source",
          "version"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "Catalog source listing the package."
          },
          "version": {
            "type": "string",
            "description": "Version to install."
          }
        }
      },
      "InstalledView": {
        "type": "object",
        "description": "An installed challenge, as the operator reports it.",
        "required": [
          "name",
          "sourceKind",
          "ready",
          "runnable",
          "mirrored",
          "activeInstances"
        ],
        "properties": {
          "activeInstances": {
            "type": "integer",
            "description": "Instances that removing the challenge would stop.",
            "minimum": 0
          },
          "catalog": {
            "type": [
              "string",
              "null"
            ],
            "description": "Catalog source, for catalog installs."
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the operator says about the installation."
          },
          "mirrored": {
            "type": "boolean",
            "description": "The package and its images are in the in-cluster registry mirror."
          },
          "name": {
            "type": "string"
          },
          "permissions": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PermissionsView"
              },
              {
                "type": "null"
              }
            ]
          },
          "ready": {
            "type": "boolean",
            "description": "Installed and verified."
          },
          "requestedVersion": {
            "type": [
              "string",
              "null"
            ],
            "description": "Version asked for, for catalog installs (may not be installed yet)."
          },
          "runnable": {
            "type": "boolean"
          },
          "signer": {
            "type": [
              "string",
              "null"
            ],
            "description": "Who signed the package."
          },
          "sourceKind": {
            "type": "string",
            "description": "Where it comes from: catalog, oci or inline (development)."
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "unrunnableReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "InstancePhase": {
        "type": "string",
        "description": "Lifecycle phase of an instance.",
        "enum": [
          "Queued",
          "Provisioning",
          "Ready",
          "Expired",
          "Failed",
          "Stopping"
        ]
      },
      "InstanceView": {
        "type": "object",
        "description": "A running attempt of the user.",
        "required": [
          "id",
          "challenge",
          "phase",
          "terminals"
        ],
        "properties": {
          "challenge": {
            "type": "string"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "description": "Instance name, used in /instances/{id} paths."
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the instance is in its phase (progress, failure reason...)."
          },
          "phase": {
            "$ref": "#/components/schemas/InstancePhase"
          },
          "terminals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TerminalView"
            }
          }
        }
      },
      "KeylessView": {
        "type": "object",
        "description": "A Sigstore keyless identity.",
        "required": [
          "issuer",
          "subjectRegExp"
        ],
        "properties": {
          "issuer": {
            "type": "string"
          },
          "subjectRegExp": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "MarketplaceEntry": {
        "type": "object",
        "description": "A package offered by a catalog source.",
        "required": [
          "source",
          "name",
          "title",
          "category",
          "difficulty",
          "tags",
          "versions",
          "updateAvailable"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "difficulty": {
            "type": "string"
          },
          "installed": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/InstalledView",
                "description": "The installed challenge of the same name, if any (from this source or\nanother one)."
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "Catalog source listing it."
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string"
          },
          "updateAvailable": {
            "type": "boolean",
            "description": "A newer version than the installed one is listed by this source."
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackageVersionView"
            },
            "description": "Versions, newest first."
          }
        }
      },
      "Me": {
        "type": "object",
        "description": "The signed-in user.",
        "required": [
          "id",
          "username",
          "displayName",
          "role",
          "score"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "description": "admin, teacher or student."
          },
          "score": {
            "type": "integer",
            "format": "int64",
            "description": "Points of every solved task."
          },
          "username": {
            "type": "string"
          }
        }
      },
      "NewCatalog": {
        "type": "object",
        "description": "A new catalog source.",
        "required": [
          "name",
          "ref",
          "trust"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the source (a DNS label)."
          },
          "ref": {
            "type": "string",
            "description": "OCI reference of the catalog index, e.g. \"ghcr.io/school/catalog:latest\"."
          },
          "trust": {
            "$ref": "#/components/schemas/TrustView"
          }
        }
      },
      "OpenTerminal": {
        "type": "object",
        "required": [
          "machine"
        ],
        "properties": {
          "machine": {
            "type": "string",
            "description": "Machine of one of the challenge's terminals."
          }
        }
      },
      "PackageVersionView": {
        "type": "object",
        "description": "A published version of a package.",
        "required": [
          "version"
        ],
        "properties": {
          "permissions": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PermissionsView"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "type": "string"
          }
        }
      },
      "PermissionsView": {
        "type": "object",
        "description": "What a package needs from the cluster, derived from it (D41).",
        "required": [
          "runtimes",
          "cpu",
          "memory",
          "egress"
        ],
        "properties": {
          "checkerImage": {
            "type": [
              "string",
              "null"
            ],
            "description": "Custom checker image, with access to the machines."
          },
          "cpu": {
            "type": "string",
            "description": "CPU of the machines of one instance, e.g. \"1500m\"."
          },
          "egress": {
            "type": "string",
            "description": "Outbound network access: none, allowlist or internet."
          },
          "egressAllowlist": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extraManifestKinds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Kinds created by extra manifests in the instance namespace."
          },
          "memory": {
            "type": "string",
            "description": "Memory of the machines of one instance, e.g. \"1536Mi\"."
          },
          "runtimes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Runtimes of its machines (pod, vm...)."
          }
        }
      },
      "StartInstance": {
        "type": "object",
        "required": [
          "challenge"
        ],
        "properties": {
          "challenge": {
            "type": "string",
            "description": "Name of the challenge."
          }
        }
      },
      "TaskResultView": {
        "type": "object",
        "description": "Result of checking one task.",
        "required": [
          "task",
          "passed"
        ],
        "properties": {
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "task": {
            "type": "string"
          }
        }
      },
      "TaskView": {
        "type": "object",
        "description": "A gradable objective.",
        "required": [
          "id",
          "title",
          "points",
          "solved"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "points": {
            "type": "integer",
            "format": "int32"
          },
          "solved": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "TerminalAccess": {
        "type": "object",
        "description": "Where the browser opens a terminal.",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "WebSocket URL of the gateway, with a short-lived token."
          }
        }
      },
      "TerminalView": {
        "type": "object",
        "description": "A terminal offered on a machine.",
        "required": [
          "machine",
          "label"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "machine": {
            "type": "string"
          }
        }
      },
      "TrustView": {
        "type": "object",
        "description": "Who a catalog source trusts (D40).",
        "properties": {
          "allowUnsigned": {
            "type": "boolean",
            "description": "Accepts unsigned packages. For local development only."
          },
          "keyless": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KeylessView"
            },
            "description": "Sigstore keyless identities, e.g. a CI workflow."
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "PEM public keys (cosign or `opslab challenge sign --key`)."
          }
        }
      },
      "VersionInfo": {
        "type": "object",
        "description": "Version of the running api.",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Project name."
          },
          "version": {
            "type": "string",
            "description": "Semantic version of the api."
          }
        }
      }
    }
  }
}
